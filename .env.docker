# ==============================================================================
# Stayone Local Docker Environment Configuration
# ==============================================================================

COMPOSE_PROJECT_NAME=stayone

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qwerty123
POSTGRES_DB=stayone_db
POSTGRES_PORT=5432

# Backend Service Configuration (ResortApp)
DATABASE_URL=postgresql+psycopg2://postgres:qwerty123@db:5432/stayone_db
BACKEND_PORT=8011
SECRET_KEY=stayone-secret-key-local-development-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
USE_LOCAL_POSTGRES_USER=false

# Channel Manager & External Integrations
AIOSELL_ACTIVE=false
AIOSELL_WEBHOOK_USERNAME=admin@teqmates.com
AIOSELL_WEBHOOK_PASSWORD=teqmates@5412!

# Email / SMTP (Optional for local testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orchidresort@gmail.com
SMTP_PASSWORD=pkdlqcthsigkqski
SMTP_FROM_EMAIL=orchidresort@gmail.com
SMTP_FROM_NAME=Stayone Resort
SMTP_USE_TLS=true

# Frontend Ports
ADMIN_PORT=3000
USEREND_PORT=3002

# Optional Nginx Gateway Port (Unified access)
GATEWAY_PORT=8080
